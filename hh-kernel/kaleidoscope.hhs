new_project("Kaleidoscope", fps=30, w=800, h=800)
# ── Layer 1: Petal element ────────────────────────────────────────
# A single petal: a colored shape that scales in/out
let petal = project.new_element("Petal", fps=30, duration=2, w=40, h=120)
petal.set_description("A single animated petal")
let petal_layer = petal.new_layer("shape")
let p = petal_layer.new_go("p", born=0)
p.add_component("Transform")
p.add_component("Visual")
p.set_kf("Transform", "scale_x", frame=0,  value=float(1.0))
p.set_kf("Transform", "scale_x", frame=30, value=float(1.4), easing="ease-in-out")
p.set_kf("Transform", "scale_x", frame=60, value=float(1.0), easing="ease-in-out")
p.set_kf("Visual", "fillColor",  frame=0,  value=color(255, 100, 180, 220))
p.set_kf("Visual", "fillColor",  frame=30, value=color(255, 200, 100, 220))
p.set_kf("Visual", "fillColor",  frame=60, value=color(255, 100, 180, 220))
p.list_kf()
# ── Layer 2: Flower element — contains 6 Petal instances ─────────
let flower = project.new_element("Flower", fps=30, duration=4, w=300, h=300)
flower.set_description("A flower made of 6 petals")
let flower_layer = flower.new_layer("petals")
# 6 petals evenly spaced at 60-degree intervals, each offset by time
let petal0 = flower_layer.instantiate("Petal", "petal0", born=0)
petal0.set_kf("ElementInstance", "position", frame=0, value=vec2(0, -80))
petal0.set_kf("ElementInstance", "rotation", frame=0, value=float(0))
let petal1 = flower_layer.instantiate("Petal", "petal1", born=0, time_offset=5)
petal1.set_kf("ElementInstance", "position", frame=0, value=vec2(69, -40))
petal1.set_kf("ElementInstance", "rotation", frame=0, value=float(60))
let petal2 = flower_layer.instantiate("Petal", "petal2", born=0, time_offset=10)
petal2.set_kf("ElementInstance", "position", frame=0, value=vec2(69, 40))
petal2.set_kf("ElementInstance", "rotation", frame=0, value=float(120))
let petal3 = flower_layer.instantiate("Petal", "petal3", born=0, time_offset=15)
petal3.set_kf("ElementInstance", "position", frame=0, value=vec2(0, 80))
petal3.set_kf("ElementInstance", "rotation", frame=0, value=float(180))
let petal4 = flower_layer.instantiate("Petal", "petal4", born=0, time_offset=20)
petal4.set_kf("ElementInstance", "position", frame=0, value=vec2(-69, 40))
petal4.set_kf("ElementInstance", "rotation", frame=0, value=float(240))
let petal5 = flower_layer.instantiate("Petal", "petal5", born=0, time_offset=25)
petal5.set_kf("ElementInstance", "position", frame=0, value=vec2(-69, -40))
petal5.set_kf("ElementInstance", "rotation", frame=0, value=float(300))
flower_layer.list_gos()
# ── Layer 3: Kaleidoscope element — contains 8 Flower instances ──
let kaleido = project.new_element("Kaleidoscope", fps=30, duration=8, w=800, h=800)
kaleido.set_description("8 flowers in a ring, slowly rotating")
let kaleido_layer = kaleido.new_layer("flowers")
# 8 flowers in a ring, each rotating slowly
let f0 = kaleido_layer.instantiate("Flower", "f0", born=0)
f0.set_kf("ElementInstance", "position", frame=0, value=vec2(250, 0))
f0.set_kf("ElementInstance", "rotation", frame=0,   value=float(0))
f0.set_kf("ElementInstance", "rotation", frame=240, value=float(360))
let f1 = kaleido_layer.instantiate("Flower", "f1", born=0, time_offset=15)
f1.set_kf("ElementInstance", "position", frame=0, value=vec2(177, 177))
f1.set_kf("ElementInstance", "rotation", frame=0,   value=float(45))
f1.set_kf("ElementInstance", "rotation", frame=240, value=float(405))
let f2 = kaleido_layer.instantiate("Flower", "f2", born=0, time_offset=30)
f2.set_kf("ElementInstance", "position", frame=0, value=vec2(0, 250))
f2.set_kf("ElementInstance", "rotation", frame=0,   value=float(90))
f2.set_kf("ElementInstance", "rotation", frame=240, value=float(450))
let f3 = kaleido_layer.instantiate("Flower", "f3", born=0, time_offset=45)
f3.set_kf("ElementInstance", "position", frame=0, value=vec2(-177, 177))
let f4 = kaleido_layer.instantiate("Flower", "f4", born=0, time_offset=60)
f4.set_kf("ElementInstance", "position", frame=0, value=vec2(-250, 0))
let f5 = kaleido_layer.instantiate("Flower", "f5", born=0, time_offset=75)
f5.set_kf("ElementInstance", "position", frame=0, value=vec2(-177, -177))
let f6 = kaleido_layer.instantiate("Flower", "f6", born=0, time_offset=90)
f6.set_kf("ElementInstance", "position", frame=0, value=vec2(0, -250))
let f7 = kaleido_layer.instantiate("Flower", "f7", born=0, time_offset=105)
f7.set_kf("ElementInstance", "position", frame=0, value=vec2(177, -177))
kaleido_layer.list_gos()
# ── Scene: place the Kaleidoscope in the scene ────────────────────
let scene = project.scene("DefaultScene")
let layer = scene.layer("drawing")
let main = layer.instantiate("Kaleidoscope", "main", born=0, loop_playback=true)
main.set_kf("ElementInstance", "position", frame=0, value=vec2(400, 400))
# Slowly rotate the whole thing
main.set_kf("ElementInstance", "rotation", frame=0,   value=float(0))
main.set_kf("ElementInstance", "rotation", frame=240, value=float(360), easing="linear")
project.info()
project.list_elements()
save("kaleidoscope.hhk")